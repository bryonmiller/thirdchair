{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/third-chair/actor-final.schema.json",
  "title": "Third Chair actor final move",
  "type": "object",
  "required": [
    "belief_opponent_responsible",
    "posture",
    "accepts_intervention",
    "public_message",
    "evidence_ids",
    "evidence_stances"
  ],
  "properties": {
    "belief_opponent_responsible": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "posture": {
      "type": "string"
    },
    "accepts_intervention": {
      "type": "boolean"
    },
    "public_message": {
      "type": "string",
      "minLength": 1
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "evidence_stances": {
      "type": "object",
      "additionalProperties": {
        "enum": [
          "support",
          "reject",
          "uncertain"
        ]
      },
      "description": "Exactly the IDs in evidence_ids, with their stated relationship to the decision. Enforced by runtime validation."
    }
  },
  "additionalProperties": false
}
