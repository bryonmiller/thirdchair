{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/third-chair/actor-final.schema.json",
  "title": "Third Chair actor final move",
  "type": "object",
  "required": ["belief_opponent_responsible", "posture", "accepts_intervention", "public_message", "evidence_ids"],
  "properties": {
    "belief_opponent_responsible": {"type": "integer", "minimum": 0, "maximum": 100},
    "posture": {"type": "string"},
    "accepts_intervention": {"type": "boolean"},
    "public_message": {"type": "string", "minLength": 1},
    "evidence_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
  },
  "additionalProperties": false
}

