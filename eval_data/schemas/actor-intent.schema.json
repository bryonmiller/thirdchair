{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/third-chair/actor-intent.schema.json",
  "title": "Third Chair actor intent",
  "type": "object",
  "required": [
    "belief_opponent_responsible",
    "posture",
    "public_message",
    "private_reason",
    "evidence_stances"
  ],
  "properties": {
    "belief_opponent_responsible": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "posture": {
      "type": "string"
    },
    "public_message": {
      "type": "string",
      "minLength": 1
    },
    "private_reason": {
      "type": "string",
      "minLength": 1
    },
    "evidence_stances": {
      "type": "object",
      "additionalProperties": {
        "enum": [
          "support",
          "reject",
          "uncertain"
        ]
      },
      "description": "The sole citation representation: every cited ID, including rejected and uncertain evidence, maps to its stance. Internal evidence_ids are derived from these keys."
    }
  },
  "additionalProperties": false
}
