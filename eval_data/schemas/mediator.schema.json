{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/third-chair/mediator.schema.json",
  "title": "Third Chair mediator move",
  "type": "object",
  "required": ["intervene", "channel", "message", "target_evidence_id", "diagnosis", "predicted_escalation", "reason"],
  "properties": {
    "intervene": {"type": "boolean"},
    "channel": {"enum": ["hold", "joint", "private_a", "private_b", "verify"]},
    "message": {"type": "string"},
    "target_evidence_id": {"type": ["string", "null"]},
    "diagnosis": {"enum": ["uncertainty", "misinformation", "commitment_trap", "domestic_pressure", "reciprocity", "none"]},
    "predicted_escalation": {"type": "integer", "minimum": 0, "maximum": 100},
    "reason": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}

